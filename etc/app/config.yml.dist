homeserver:
  # The canonical homeserver domain name
  server_name: __HOMESERVER_SERVER_NAME__
  url: __HOMESERVER_URL__

user:
  mxid_localpart: baibot

  # Authentication: set EITHER password OR access_token + device_id OR tron.
  # See docs/configuration/authentication.md.
  #
  # Password-based login (traditional homeservers):
  password: baibot

  # Access token login (for Matrix Authentication Service/OIDC-enabled homeservers):
  # Generate a token via: mas-cli manage issue-compatibility-token <username> [device_id]
  # access_token: null
  # device_id: null

  # TRON wallet login (the Chums homeserver, where password login is off).
  # The wallet must already be bound to the bot's account on the homeserver.
  # Set either private_key (32 bytes in hex) or seed_phrase (12-24 English words);
  # better keep it in the environment (BAIBOT_USER_TRON_PRIVATE_KEY / BAIBOT_USER_TRON_SEED_PHRASE).
  # origin defaults to https://baibot.tron.mx, the value the Chums homeserver allows for this bot.
  # tron:
  #   private_key: null
  #   seed_phrase: null
  #   origin: null

  # The name the bot uses as a display name and when it refers to itself.
  # Leave empty to use the default (baibot).
  name: baibot

  # An optional path to an image file to be used as a custom avatar image.
  # - null or empty string: use the default avatar
  # - "keep": don't touch the avatar, keep whatever is already set
  # - any other value: path to a custom avatar image file
  avatar: null

  encryption:
    # An optional passphrase to use for backing up and recovering the bot's encryption keys.
    # You can use any string here.
    #
    # The keys (cross-signing and the room key backup) are kept in the account's secret storage
    # under this passphrase. At every start the bot imports them from there, creating the
    # secret storage if the account has none yet; losing the session/database (see persistence)
    # therefore does not lose access to old messages in encrypted rooms. The log says what
    # happened (`Recovery: secrets imported from secret storage`, `Recovery: secret storage created`).
    #
    # With the TRON wallet login (user.tron), null means the passphrase is derived from the
    # wallet key, the same way the Chums web client derives it through TronLink; a value set
    # here takes precedence. Without a wallet, null means the keys stay on this device only,
    # and losing your session/database will mean you lose access to old messages in encrypted rooms.
    #
    # Changing this subsequently will also cause you to lose access to old messages in encrypted rooms.
    # If you really need to change this:
    # - Set `recovery_reset_allowed` to `true` and adjust the passphrase
    # - Restart the bot; it resets the secret storage key from the new passphrase
    # - Then restore `recovery_reset_allowed` to `false` to prevent accidental resets in the future
    recovery_passphrase: long-and-secure-passphrase-here

    # An optional flag allowing the bot to reset the secret storage key from the passphrase
    # when the passphrase does not open it, and to replace a key backup this device cannot use.
    # Both lose the history of encrypted rooms that this device has not received.
    recovery_reset_allowed: false

# Command prefix. Leave empty to use the default (!bai).
command_prefix: "!bai"

room:
  # Whether the bot should send an introduction message after joining a room.
  post_join_self_introduction_enabled: true

  # Optional. A fixed introduction (Markdown) per locale that replaces the built-in one
  # (bot name, agents, commands). Sent in the language of the user who invited the bot;
  # a text for `i18n.fallback_locale` is required. See docs/configuration/i18n.md.
  # post_join_self_introduction_text:
  #   en: "Hi! I am an assistant bot. Ask me anything."
  #   ru: "Привет! Я бот-ассистент. Спрашивай о чём угодно."

i18n:
  # Language of the replies to users whose client has not declared one with a
  # `cc.chums.set_user_locale` event. One of the locales under locales/.
  # See docs/configuration/i18n.md.
  fallback_locale: en

access:
  # Space-separated list of MXID patterns which specify who is an admin.
  admin_patterns:
    - "@admin:__HOMESERVER_SERVER_NAME__"

  # Optional. When true, the bot's commands (`!bai help`, `!bai config ...`, etc.) sent by users
  # who are not administrators are ignored without a reply, except the commands listed in
  # `commands_admin_exempt` (by their first word). Conversation with the bot is not affected.
  # See docs/access.md.
  # commands_admin_only: false
  # commands_admin_exempt: [balance, topup, image]

persistence:
  # This is unset here, because we expect the configuration to come from an environment variable (BAIBOT_PERSISTENCE_DATA_DIR_PATH).
  # In your setup, you may wish to set this to a directory path.
  data_dir_path: null

  # An optional secret for encrypting the bot's session data (stored in data_dir_path).
  # This must be 32-bytes (64 characters when HEX-encoded).
  # Generate it with: `openssl rand -hex 32`, or pass it as
  # BAIBOT_PERSISTENCE_SESSION_ENCRYPTION_KEY and leave this null.
  # Never copy a key out of a file that is published somewhere: this one is
  # left unset on purpose.
  # Leave null or empty to avoid using encryption.
  # Changing this subsequently requires that you also throw away all data stored in data_dir_path.
  session_encryption_key: null

  # An optional secret for encrypting bot configuration stored in Matrix's account data.
  # This must be 32-bytes (64 characters when HEX-encoded).
  # Generate it with: `openssl rand -hex 32`, or pass it as
  # BAIBOT_PERSISTENCE_CONFIG_ENCRYPTION_KEY and leave this null.
  # Never copy a key out of a file that is published somewhere: this one is
  # left unset on purpose.
  # Leave null or empty to avoid using encryption.
  # Changing this subsequently will make you lose your configuration.
  config_encryption_key: null

agents:
  # A list of statically-defined agents.
  #
  # Below are a few common choices on popular providers, preconfigured for development purposes (see docs/development.md).
  # You may enable some of the ones you see below or define others.
  # You can also leave this list empty and only define agents dynamically (via chat).
  #
  # Uncomment one or more of these and potentially adjust their configuration (API key, etc).
  # Consider setting `initial_global_config.handler.*` to an agent that you enable here.
  static_definitions:
    # - id: openai
    #   provider: openai
    #   config:
    #     base_url: https://api.openai.com/v1
    #     api_key: ""
    #     text_generation:
    #       model_id: gpt-5.4
    #       prompt: "You are a brief, but helpful bot called {{ baibot_name }} powered by the {{ baibot_model_id }} model. The date/time of this conversation's start is: {{ baibot_conversation_start_time_utc }}."
    #       temperature: 1.0
    #       # Reasoning models need to use `max_completion_tokens` instead of `max_response_tokens`.
    #       # If you're dealing with a non-reasoning model, specify `max_response_tokens` and unset `max_completion_tokens`.
    #       max_response_tokens: null
    #       max_completion_tokens: 128000
    #       max_context_tokens: 400000
    #       # Built-in tools
    #       tools:
    #         web_search: false
    #         code_interpreter: false
    #     speech_to_text:
    #       model_id: whisper-1
    #     text_to_speech:
    #       model_id: tts-1-hd
    #       voice: onyx
    #       speed: 1.0
    #       response_format: opus
    #     image_generation:
    #       # Use gpt-image-2.5-flare for faster generation.
    #       model_id: gpt-image-2.5-sunburst
    #       style: null
    #       # null lets the model choose; examples: 1024x1024, 1536x1024, 2048x2048.
    #       size: null
    #       # Options: low, medium, high, xhigh, max, auto; null uses auto.
    #       quality: null
    #
    # - id: localai
    #   provider: localai
    #   config:
    #     base_url: http://127.0.0.1:42027/v1
    #     api_key: null
    #     text_generation:
    #       model_id: gpt-4
    #       prompt: "You are a brief, but helpful bot called {{ baibot_name }} powered by the {{ baibot_model_id }} model. The date/time of this conversation's start is: {{ baibot_conversation_start_time_utc }}."
    #       temperature: 1.0
    #       max_response_tokens: 16384
    #       max_context_tokens: 128000
    #     speech_to_text:
    #       model_id: whisper-1
    #     text_to_speech:
    #       model_id: tts-1
    #       voice: onyx
    #       speed: 1.0
    #       response_format: opus
    #     image_generation:
    #       model_id: stablediffusion
    #       style: vivid
    #       # Intentionally defaults to a small value to improve performance
    #       size: 256x256
    #       quality: standard
    #
    # - id: ollama
    #   provider: ollama
    #   config:
    #     base_url: "http://127.0.0.1:42026/v1"
    #     api_key: null
    #     text_generation:
    #       model_id: "gemma2:2b"
    #       prompt: "You are a brief, but helpful bot called {{ baibot_name }} powered by the {{ baibot_model_id }} model. The date/time of this conversation's start is: {{ baibot_conversation_start_time_utc }}."
    #       temperature: 1.0
    #       max_response_tokens: 4096
    #       max_context_tokens: 128000

# Initial global configuration. This only affects the first run of the bot.
# Configuration is later managed at runtime.
initial_global_config:
  handler:
    catch_all: null
    text_generation: null
    text_to_speech: null
    speech_to_text: null
    image_generation: null

  # Space-separated list of MXID patterns which specify who can use the bot.
  # By default, we let anyone on the homeserver use the bot.
  user_patterns:
    - "@*:__HOMESERVER_SERVER_NAME__"

# Optional billing of LLM calls, backed by an append-only ledger (SQLite).
# Remove or comment out the whole section to run without billing.
# Every key is optional; the values below are the defaults. See docs/configuration/billing.md.
#
# billing:
#   # Amount (USD) held off the room balance while a single LLM call is in flight.
#   reserve_amount_usd: 0.03
#   # Multiplier applied to the provider's cost (1.0 = at cost, 2.0 = double).
#   markup_pct: 2.0
#   # Bot-wide spending caps per UTC calendar day and month.
#   daily_cap_usd: 50.0
#   monthly_cap_usd: 1000.0
#   # Bounds for a single top-up request from a user.
#   min_topup_usd: 0.10
#   max_topup_usd: 1.0
#   # Full Matrix user ids allowed to run billing administration commands.
#   admin_mxids:
#     - "@admin:__HOMESERVER_SERVER_NAME__"
#   # Path to the ledger file. Defaults to `billing.db` inside `persistence.data_dir_path`.
#   db_path: null
#   # Fallback prices (USD per million tokens) used when the provider does not report
#   # the cost of a call. Entries add to (or override) the built-in table.
#   pricing:
#     x-ai/grok-4.20:
#       input_usd_per_million_tokens: 1.25
#       output_usd_per_million_tokens: 2.5

# Optional top-ups of the billing ledger through the x402 payment sidecar (see x402-sidecar/).
# Requires the billing section. See docs/configuration/x402.md.
#
# x402:
#   # Base URL of the payment sidecar.
#   sidecar_url: http://127.0.0.1:8402
#   # Secret shared with the sidecar; it signs settlement notifications with it.
#   internal_secret: ""
#   # Where the bot listens for the sidecar's settlement notifications.
#   # Keep it on loopback unless the sidecar runs elsewhere (then also set the flag below
#   # and firewall the port to the sidecar).
#   internal_bind: 127.0.0.1
#   internal_port: 9000
#   allow_non_loopback_bind: false

# Controls logging.
#
# Sets all tracing targets (external crates) to warn, and our own logs to debug.
# For even more verbose logging, one may also use trace.
#
# matrix_sdk_crypto may be chatty and could be added with an error level.
#
# Learn more here: https://stackoverflow.com/a/73735203
logging: warn,mxlink=debug,baibot=debug
